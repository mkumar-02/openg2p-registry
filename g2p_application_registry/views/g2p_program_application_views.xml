<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_g2p_program_application_tree" model="ir.ui.view">
            <field name="name">g2p.program.application.tree</field>
            <field name="model">g2p.program.application</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="program_mnemonic" />
                    <field name="registrant_id" />
                    <field name="application_id" />
                    <field name="status" />
                </tree>
            </field>
        </record>

        <record id="view_g2p_program_application_form" model="ir.ui.view">
            <field name="name">g2p.program.application.form</field>
            <field name="model">g2p.program.application</field>
            <field name="arch" type="xml">
                <form string="Program Application">
                    <sheet>
                        <group>
                            <field name="program_mnemonic" />
                            <field name="registrant_id" />
                            <field name="application_id" />
                            <field name="status" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_g2p_program_application" model="ir.actions.act_window">
            <field name="name">Program Applications</field>
            <field name="res_model">g2p.program.application</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
