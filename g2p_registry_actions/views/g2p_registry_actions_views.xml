<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_g2p_registry_actions_tree" model="ir.ui.view">
            <field name="name">g2p.registry.actions.tree</field>
            <field name="model">g2p.registry.actions</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" />
                    <field name="formio_id" />
                    <field name="active" />
                </tree>
            </field>
        </record>

        <record id="view_g2p_registry_actions_form" model="ir.ui.view">
            <field name="name">g2p.registry.actions.form</field>
            <field name="model">g2p.registry.actions</field>
            <field name="arch" type="xml">
                <form string="Registry Action">
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="formio_id" />
                            <field name="active" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_g2p_registry_actions" model="ir.actions.act_window">
            <field name="name">Actions</field>
            <field name="res_model">g2p.registry.actions</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
